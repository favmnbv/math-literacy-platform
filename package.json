{
  "name": "talan-math-literacy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "prisma generate && next build --webpack",
    "start": "node node_modules/next/dist/bin/next start -H 0.0.0.0",
    "db:generate": "prisma generate",
    "db:local": "node scripts/local.mjs setup",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "db:seed": "node scripts/local.mjs seed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "node scripts/local.mjs start",
    "db:start": "node scripts/local.mjs db"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@prisma/adapter-pg": "7.1.0",
    "@prisma/client": "7.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^13.4.4",
    "katex": "^0.16.28",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "3.9.9",
    "prisma": "7.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
