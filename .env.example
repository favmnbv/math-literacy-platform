# Local preview. Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Empty = local PostgreSQL socket started by pnpm dev/preview. External PostgreSQL required for production.
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/postgres
# Only for the explicit demo seed; never use demo accounts with real students.
DEMO_SEED=true
